# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5500

# Database (client-provided in production; local/dev connection here)
MONGO_URI=mongodb://127.0.0.1:27017/careerz

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (client-provided SMTP in production; leave blank to log OTP/emails to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareerZ <no-reply@careerz.local>

# Stripe (client-provided; get test/sandbox keys free at https://dashboard.stripe.com/test/apikeys)
# Card checkout is disabled with a clear error until these are set — no fake payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe CLI (`stripe listen`) in dev, or the Dashboard's webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=

# Paddle (client-provided; free sandbox account at https://sandbox-vendors.paddle.com/signup)
# CareerZ's primary worldwide gateway (cards, Apple Pay, Google Pay). Card checkout is disabled
# with a clear error until these are set — no fake payments.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
# From Paddle Dashboard -> Developer Tools -> Notifications -> your webhook destination.
PADDLE_WEBHOOK_SECRET=
# 'sandbox' while testing, 'production' once you switch to a live Paddle account.
PADDLE_ENVIRONMENT=sandbox

# Translation — free by default (MyMemory, no key needed). Leave as-is for a working
# free translator. Switch to 'libretranslate' + LIBRETRANSLATE_URL once you self-host it on your
# own VPS for genuinely unlimited free translation (see LIBRETRANSLATE_SETUP.md).
TRANSLATION_PROVIDER=mymemory
MYMEMORY_EMAIL=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
