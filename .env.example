# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5500

# Database (client-provided in production; local/dev connection here)
MONGO_URI=mongodb://127.0.0.1:27017/careerz

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email (client-provided SMTP in production; leave blank to log OTP/emails to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareerZ <no-reply@careerz.local>
